{
  "functions": {
    "api/og/[slug].ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/dp/:slug",
      "has": [{ "type": "query", "key": "_spa" }],
      "destination": "/index.html"
    },
    {
      "source": "/dp/:slug",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}