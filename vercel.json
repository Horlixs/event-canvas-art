{
  "headers": [
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dp/:slug",
      "has": [{ "type": "query", "key": "_spa" }],
      "destination": "/index.html"
    },
    {
      "source": "/dp/:slug",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}