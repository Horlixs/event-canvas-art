{
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/**/*.tsx": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/dp/:slug",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}