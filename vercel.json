{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "_spa" }],
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/api/og/index"
    },
    {
      "source": "/dp/:slug",
      "has": [{ "type": "query", "key": "_spa" }],
      "destination": "/index.html"
    },
    {
      "source": "/dp/:slug",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}